{
  "$schema": "https://railway.app/schema.json",
  "name": "ai-api-dashboard",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "NEXTAUTH_TRUST_HOST=true npx prisma generate && npx prisma db push && npm start",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "env": {
  }
}
